# ── Supabase ─────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Expo Push Notifications ───────────────────────────────────────
EXPO_PUBLIC_PROJECT_ID=your-expo-project-id

# ── Google OAuth (from Google Cloud Console) ──────────────────────
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com

# ── Calendar sync OAuth (2-way Google Calendar / Outlook sync) ────
# Google: same Cloud Console project as Sign-In above, but a SEPARATE
# OAuth client with the Calendar API scope added (the Sign-In client IDs
# above only carry the default identity scope) — Google requires explicit
# consent-screen configuration/review for a sensitive scope like calendar
# access. Redirect URI to register on both providers: familycube://calendar-oauth-callback
EXPO_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=your-calendar-client-id.apps.googleusercontent.com
EXPO_PUBLIC_MS_GRAPH_CLIENT_ID=your-azure-app-client-id

# ── Supabase Edge Function Secrets (set in dashboard → Settings → Secrets) ──
# RESEND_API_KEY=re_xxxxx         (for family invite emails via Resend.com)
# APP_URL=https://furever.app     (production URL for invite links)
# GOOGLE_CALENDAR_CLIENT_ID=...          (calendar-oauth-exchange, calendar-sync-push, calendar-webhook-google, calendar-channel-renewal)
# GOOGLE_CALENDAR_CLIENT_SECRET=...
# MS_GRAPH_CLIENT_ID=...                 (calendar-oauth-exchange, calendar-sync-push, calendar-webhook-outlook, calendar-channel-renewal)
# MS_GRAPH_CLIENT_SECRET=...
